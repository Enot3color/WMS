# Backend (copy to backend/.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/print_warehouse?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000

# MinIO / S3-compatible storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="print-warehouse"
S3_REGION="us-east-1"

# Frontend (copy to frontend/.env)
# Dev: leave empty — Vite proxy forwards /api to localhost:3000
# Prod: use /api when nginx proxies to backend on same domain
VITE_API_URL="/api"

# Seed (first run: npm run prisma:seed --prefix backend)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Администратор"
