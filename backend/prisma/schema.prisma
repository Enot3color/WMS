generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  WAREHOUSE
  MANAGER
  ADMIN
}

enum CounterpartyType {
  SUPPLIER
  CONTRACTOR
  BOTH
}

enum RequestStatus {
  SUBMITTED
  IN_PROGRESS
  ISSUED
  AWAITING_SUPPLY
  COMPLETED
  CANCELLED
}

enum MovementType {
  RECEIPT
  ISSUE
  WRITE_OFF
  RETURN
}

enum MovementStatus {
  DRAFT
  POSTED
  REVERSED
}

enum SupplierOrderStatus {
  DRAFT
  SENT
  IN_TRANSIT
  DELIVERED
  ACCEPTED
}

model User {
  id           String   @id @default(cuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  phone        String   @unique
  login        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  managerRequests   ManagerRequest[]   @relation("RequestManager")
  assignedRequests  ManagerRequest[]   @relation("RequestAssignee")
  movementDocuments MovementDocument[]
  supplierOrders    SupplierOrder[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  materials Material[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("categories")
}

model Unit {
  id        String     @id @default(cuid())
  name      String     @unique
  shortName String     @unique @map("short_name")
  materials Material[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("units")
}

model Counterparty {
  id          String           @id @default(cuid())
  name        String           @unique
  type        CounterpartyType @default(SUPPLIER)
  legalEntity String?          @map("legal_entity")
  contactInfo String?          @map("contact_info")
  address     String?
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  offers         CounterpartyOffer[]
  supplierOrders SupplierOrder[]

  @@map("counterparties")
}

model CounterpartyOffer {
  id             String   @id @default(cuid())
  counterpartyId String   @map("counterparty_id")
  materialId     String   @map("material_id")
  price          Decimal  @default(0) @db.Decimal(12, 2)
  deliveryMethod String?  @map("delivery_method")
  supplyStatus   String?  @map("supply_status")
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  material     Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([counterpartyId, materialId])
  @@index([materialId, isPrimary])
  @@map("counterparty_offers")
}

model StatusReference {
  id        String   @id @default(cuid())
  group     String
  code      String
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([group, code])
  @@map("status_references")
}

model AppScreen {
  code        String                 @id
  name        String
  path        String?
  sortOrder   Int                    @default(0) @map("sort_order")
  permissions RoleScreenPermission[]

  @@map("app_screens")
}

model RoleScreenPermission {
  id         String    @id @default(cuid())
  role       UserRole
  screenCode String    @map("screen_code")
  canRead    Boolean   @default(true) @map("can_read")
  canCreate  Boolean   @default(false) @map("can_create")
  canUpdate  Boolean   @default(false) @map("can_update")
  canDelete  Boolean   @default(false) @map("can_delete")
  screen     AppScreen @relation(fields: [screenCode], references: [code], onDelete: Cascade)

  @@unique([role, screenCode])
  @@map("role_screen_permissions")
}

model Material {
  id              String    @id @default(cuid())
  name            String
  sku             String?   @unique
  categoryId      String    @map("category_id")
  unitId          String    @map("unit_id")
  series          String?
  color           String?
  densityGsm      Int?      @map("density_gsm")
  thicknessMicron Int?      @map("thickness_micron")
  texture         String?
  coating         String?
  dimensions      String?
  description     String?
  minStock        Decimal?  @map("min_stock") @db.Decimal(12, 3)
  purchaseBatch   Decimal?  @map("purchase_batch") @db.Decimal(12, 3)
  photoUrl        String?   @map("photo_url")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category      Category              @relation(fields: [categoryId], references: [id])
  unit          Unit                  @relation(fields: [unitId], references: [id])
  stockBalance  StockBalance?
  requestLines  ManagerRequestLine[]
  movementLines MovementLine[]
  offers        CounterpartyOffer[]
  supplierLines SupplierOrderLine[]

  @@index([name])
  @@map("materials")
}

model StockBalance {
  id         String   @id @default(cuid())
  materialId String   @unique @map("material_id")
  available  Decimal  @default(0) @db.Decimal(12, 3)
  reserved   Decimal  @default(0) @db.Decimal(12, 3)
  ordered    Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime @updatedAt @map("updated_at")

  material Material @relation(fields: [materialId], references: [id])

  @@map("stock_balances")
}

model ManagerRequest {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  managerId       String        @map("manager_id")
  assigneeId      String?       @map("assignee_id")
  status          RequestStatus @default(SUBMITTED)
  dealNumber      String?       @map("deal_number")
  clientInfo      String?       @map("client_info")
  comment         String?
  expectedDate    DateTime?     @map("expected_date")
  warehouseSeenAt DateTime?     @map("warehouse_seen_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  manager        User                 @relation("RequestManager", fields: [managerId], references: [id])
  assignee       User?                @relation("RequestAssignee", fields: [assigneeId], references: [id])
  lines          ManagerRequestLine[]
  statusLog      RequestStatusLog[]
  movements      MovementDocument[]
  supplierOrders SupplierOrder[]

  @@index([status, createdAt])
  @@map("manager_requests")
}

model ManagerRequestLine {
  id         String   @id @default(cuid())
  requestId  String   @map("request_id")
  materialId String   @map("material_id")
  quantity   Decimal  @db.Decimal(12, 3)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(12, 2)

  request  ManagerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id])

  @@map("manager_request_lines")
}

model RequestStatusLog {
  id        String        @id @default(cuid())
  requestId String        @map("request_id")
  status    RequestStatus
  userId    String?       @map("user_id")
  comment   String?
  createdAt DateTime      @default(now()) @map("created_at")

  request ManagerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_status_logs")
}

model MovementDocument {
  id          String         @id @default(cuid())
  number      Int            @unique @default(autoincrement())
  type        MovementType
  status      MovementStatus @default(DRAFT)
  userId      String         @map("user_id")
  requestId   String?        @map("request_id")
  reason      String?
  comment     String?
  postedAt    DateTime?      @map("posted_at")
  reversedAt  DateTime?      @map("reversed_at")
  reverseOfId String?        @unique @map("reverse_of_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  user      User              @relation(fields: [userId], references: [id])
  request   ManagerRequest?   @relation(fields: [requestId], references: [id])
  reverseOf MovementDocument? @relation("MovementReversal", fields: [reverseOfId], references: [id])
  reversal  MovementDocument? @relation("MovementReversal")
  lines     MovementLine[]

  @@map("movement_documents")
}

model MovementLine {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  materialId String   @map("material_id")
  quantity   Decimal  @db.Decimal(12, 3)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(12, 2)

  document MovementDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  material Material         @relation(fields: [materialId], references: [id])

  @@map("movement_lines")
}

model SupplierOrder {
  id               String              @id @default(cuid())
  number           Int                 @unique @default(autoincrement())
  managerRequestId String?             @map("manager_request_id")
  counterpartyId   String              @map("counterparty_id")
  status           SupplierOrderStatus @default(DRAFT)
  deliveryMethod   String?             @map("delivery_method")
  createdById      String              @map("created_by_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  managerRequest ManagerRequest?     @relation(fields: [managerRequestId], references: [id])
  counterparty   Counterparty        @relation(fields: [counterpartyId], references: [id])
  createdBy      User                @relation(fields: [createdById], references: [id])
  lines          SupplierOrderLine[]

  @@index([status])
  @@map("supplier_orders")
}

model SupplierOrderLine {
  id              String  @id @default(cuid())
  supplierOrderId String  @map("supplier_order_id")
  materialId      String  @map("material_id")
  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@map("supplier_order_lines")
}

model Notification {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  type       String
  title      String
  message    String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  entity    String
  entityId  String   @map("entity_id")
  action    String
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}
