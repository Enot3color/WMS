generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  WAREHOUSE
  MANAGER
  ADMIN
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  ORDERED
  ARRIVED
  COMPLETED
  CANCELLED
}

enum MovementType {
  RECEIPT
  ISSUE
  WRITE_OFF
  RETURN
}

enum MovementStatus {
  DRAFT
  POSTED
  REVERSED
}

enum InventorySessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  managerRequests   ManagerRequest[] @relation("RequestManager")
  assignedRequests  ManagerRequest[] @relation("RequestAssignee")
  movementDocuments MovementDocument[]
  inventorySessions InventorySession[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  materials Material[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("categories")
}

model Unit {
  id        String     @id @default(cuid())
  name      String     @unique
  shortName String     @unique @map("short_name")
  materials Material[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("units")
}

model Supplier {
  id               String     @id @default(cuid())
  name             String     @unique
  contactInfo      String?    @map("contact_info")
  materialsPrimary Material[] @relation("PrimarySupplier")
  materialsAlt     Material[] @relation("AltSupplier")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("suppliers")
}

model WarehouseZone {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  inventorySessions  InventorySession[]
  inventoryLines     InventoryLine[]
  createdAt          DateTime            @default(now()) @map("created_at")
  materialPlacements MaterialPlacement[]

  @@map("warehouse_zones")
}

model Material {
  id                String    @id @default(cuid())
  name              String
  sku               String?   @unique
  categoryId        String    @map("category_id")
  unitId            String    @map("unit_id")
  primarySupplierId String?   @map("primary_supplier_id")
  altSupplierId     String?   @map("alt_supplier_id")
  minStock          Decimal?  @map("min_stock") @db.Decimal(12, 3)
  purchaseBatch     Decimal?  @map("purchase_batch") @db.Decimal(12, 3)
  seasonCutoff      DateTime? @map("season_cutoff")
  photoUrl          String?   @map("photo_url")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  category        Category            @relation(fields: [categoryId], references: [id])
  unit            Unit                @relation(fields: [unitId], references: [id])
  primarySupplier Supplier?           @relation("PrimarySupplier", fields: [primarySupplierId], references: [id])
  altSupplier     Supplier?           @relation("AltSupplier", fields: [altSupplierId], references: [id])
  stockBalance    StockBalance?
  reservations    Reservation[]
  requestLines    ManagerRequestLine[]
  movementLines   MovementLine[]
  inventoryLines  InventoryLine[]
  placements      MaterialPlacement[]

  @@index([name])
  @@map("materials")
}

model MaterialPlacement {
  id         String @id @default(cuid())
  materialId String @map("material_id")
  zoneId     String @map("zone_id")

  material Material      @relation(fields: [materialId], references: [id])
  zone     WarehouseZone @relation(fields: [zoneId], references: [id])

  @@unique([materialId, zoneId])
  @@map("material_placements")
}

model StockBalance {
  id        String   @id @default(cuid())
  materialId String  @unique @map("material_id")
  available Decimal  @default(0) @db.Decimal(12, 3)
  reserved  Decimal  @default(0) @db.Decimal(12, 3)
  ordered   Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt @map("updated_at")

  material Material @relation(fields: [materialId], references: [id])

  @@map("stock_balances")
}

model Reservation {
  id         String   @id @default(cuid())
  materialId String   @map("material_id")
  requestId  String   @map("request_id")
  quantity   Decimal  @db.Decimal(12, 3)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  releasedAt DateTime? @map("released_at")

  material Material       @relation(fields: [materialId], references: [id])
  request  ManagerRequest @relation(fields: [requestId], references: [id])

  @@index([materialId, isActive])
  @@map("reservations")
}

model ManagerRequest {
  id           String        @id @default(cuid())
  number       Int           @unique @default(autoincrement())
  managerId    String        @map("manager_id")
  assigneeId   String?       @map("assignee_id")
  status       RequestStatus @default(NEW)
  dealNumber   String?       @map("deal_number")
  comment      String?
  expectedDate DateTime?     @map("expected_date")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  manager    User                 @relation("RequestManager", fields: [managerId], references: [id])
  assignee   User?                @relation("RequestAssignee", fields: [assigneeId], references: [id])
  lines      ManagerRequestLine[]
  statusLog  RequestStatusLog[]
  reservations Reservation[]

  @@map("manager_requests")
}

model ManagerRequestLine {
  id         String  @id @default(cuid())
  requestId  String  @map("request_id")
  materialId String  @map("material_id")
  quantity   Decimal @db.Decimal(12, 3)
  fromStock  Boolean @default(false) @map("from_stock")
  unitPrice  Decimal? @map("unit_price") @db.Decimal(12, 2)

  request  ManagerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id])

  @@map("manager_request_lines")
}

model RequestStatusLog {
  id        String        @id @default(cuid())
  requestId String        @map("request_id")
  status    RequestStatus
  userId    String?       @map("user_id")
  comment   String?
  createdAt DateTime      @default(now()) @map("created_at")

  request ManagerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_status_logs")
}

model MovementDocument {
  id          String         @id @default(cuid())
  number      Int            @unique @default(autoincrement())
  type        MovementType
  status      MovementStatus @default(DRAFT)
  userId      String         @map("user_id")
  requestId   String?        @map("request_id")
  reason      String?
  comment     String?
  postedAt    DateTime?      @map("posted_at")
  reversedAt  DateTime?      @map("reversed_at")
  reverseOfId String?        @unique @map("reverse_of_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id])
  reverseOf MovementDocument? @relation("MovementReversal", fields: [reverseOfId], references: [id])
  reversal  MovementDocument? @relation("MovementReversal")
  lines     MovementLine[]

  @@map("movement_documents")
}

model MovementLine {
  id         String  @id @default(cuid())
  documentId String  @map("document_id")
  materialId String  @map("material_id")
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(12, 2)

  document MovementDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  material Material         @relation(fields: [materialId], references: [id])

  @@map("movement_lines")
}

model InventorySession {
  id        String                 @id @default(cuid())
  zoneId    String                 @map("zone_id")
  userId    String                 @map("user_id")
  status    InventorySessionStatus @default(IN_PROGRESS)
  startedAt DateTime               @default(now()) @map("started_at")
  closedAt  DateTime?              @map("closed_at")

  zone  WarehouseZone   @relation(fields: [zoneId], references: [id])
  user  User            @relation(fields: [userId], references: [id])
  lines InventoryLine[]

  @@map("inventory_sessions")
}

model InventoryLine {
  id              String  @id @default(cuid())
  sessionId       String  @map("session_id")
  materialId      String  @map("material_id")
  zoneId          String  @map("zone_id")
  expectedQty     Decimal @map("expected_qty") @db.Decimal(12, 3)
  countedQty      Decimal? @map("counted_qty") @db.Decimal(12, 3)
  discrepancyQty  Decimal? @map("discrepancy_qty") @db.Decimal(12, 3)
  discrepancyCost Decimal? @map("discrepancy_cost") @db.Decimal(12, 2)

  session  InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  material Material         @relation(fields: [materialId], references: [id])
  zone     WarehouseZone    @relation(fields: [zoneId], references: [id])

  @@map("inventory_lines")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  entity     String
  entityId   String   @map("entity_id")
  action     String
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}
